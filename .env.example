# ==========================================
# NEXIDION ENVIRONMENT CONFIGURATION
# Copy this file to .env and change the values
# ==========================================

# --- APPLICATION ---
FLASK_ENV="production"
APP_ENV="production"
JWT_SECRET_KEY="change_me_to_a_random_secure_string_like_xyz123"
ADMIN_PASSWORD="XXX"

# --- DATABASE (PostgreSQL) ---
# DB_HOST matches the service name in docker-compose.yml
DB_HOST="postgres"
DB_PORT="5432"
DB_NAME="nexidion"
DB_USER="nexidion_user"
DB_PASSWORD="change_me_to_a_secure_password"

# --- OPTIONAL: AI TASK RUNNER ---
# Leave these blank if you do not plan to run the AI Worker profile.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# OpenRouter uses its OpenAI-compatible API. Set the model explicitly; model
# slugs ending in :free are supported, but the available catalog can change.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
# Optional comma-separated override (at most 10 models) and catalog cache TTL.
# OPENROUTER_CURATED_MODELS="vendor/model-one,vendor/model-two"
# OPENROUTER_CATALOG_CACHE_SECONDS=300
# Optional attribution headers recommended by OpenRouter:
# OPENROUTER_HTTP_REFERER="https://your-nexidion.example"
# OPENROUTER_APP_TITLE="Nexidion"

# Agent response streaming and deadlines. Reasoning uses the provider default
# unless explicitly set. Full payload traces may contain sensitive note text.
NEXIDION_LLM_REQUEST_TIMEOUT_SECONDS=1800
NEXIDION_LLM_HARD_TURN_TIMEOUT_SECONDS=1800
NEXIDION_MAX_OUTPUT_TOKENS=12000
# NEXIDION_REASONING_EFFORT=medium
NEXIDION_CAPTURE_STREAM_PAYLOADS=false

# If you use a local LLM (e.g., LM Studio, Ollama), uncomment and adjust these:
# Bare-metal local OpenAI-compatible server:
# LOCAL_LLM_URL="http://127.0.0.1:1234/v1"
# Docker Desktop / Docker host bridge override:
# DOCKER_LOCAL_LLM_URL="http://host.docker.internal:1234/v1"
# LOCAL_LLM_MODEL="local"
# LOCAL_LLM_API_KEY="not-needed"
# Managed image storage (use an absolute path for bare-metal installs)
ASSET_STORAGE_FOLDER=./asset_storage
