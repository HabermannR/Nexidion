FROM python:3.13-slim

# Matches the working_dir: /app in your docker-compose.yml task-runner service
WORKDIR /app

# Fix security warnings and install uv
RUN pip install --upgrade pip setuptools wheel uv

# Copy the requirements file from the backend directory
COPY backend/requirements.txt .

# Install dependencies extremely fast
RUN uv pip install --system --no-cache -r requirements.txt

# Copy the backend folder as a proper Python package
COPY backend/ ./backend/

# Copy the orchestration scripts from the root
COPY agent/   ./agent/
COPY wsgi.py task_runner.py ./

# Run the app via gunicorn (this gets overridden by task-runner's command in docker-compose)
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "wsgi:app"]