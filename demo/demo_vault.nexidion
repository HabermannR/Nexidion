    {
      "id": "b03b636c-c624-4df2-a492-3488f817aceb",
      "parent_id": "9b8287d7-ac82-4c77-b0be-cda9267e7311",
      "icon": "bx-folder-open",
      "ai_summary": "- Serves as the central directory for team guidelines and specifications\n- Houses formal design standards and document formatting rules\n- Designed to remain static during normal working sessions",
      "summary_is_current": true,
      "title": "Core Documentation",
      "content": "# Core Documentation\nThis directory contains the established guidelines, specifications, and foundational standards for the **Vector & Node Labs** team. \n\nRefer to these documents to maintain consistency across our software architecture and development practices.",
      "created_at": "2026-05-24T19:38:53+00:00Z",
      "updated_at": "2026-05-24T19:38:53+00:00Z",
      "versions": [
        {
          "version": 1,
          "title": "Core Documentation",
          "content": "# Core Documentation\nThis directory contains the established guidelines, specifications, and foundational standards for the **Vector & Node Labs** team. \n\nRefer to these documents to maintain consistency across our software architecture and development practices.",
          "created_at": "2026-05-24T19:38:53+00:00Z",
          "author_display_name": "Admin"
        }
      ]
    },
    {
      "id": "4862bc69-aac9-433e-bf51-cedb63f330d5",
      "parent_id": "9b8287d7-ac82-4c77-b0be-cda9267e7311",
      "icon": "bxs-inbox",
      "ai_summary": "- Functions as the team's intake inbox for raw, unorganized notes\n- Contains transcripts, phone call memos, and rough technical drafts\n- Serves as the primary target for AI restructuring and cataloging tasks",
      "summary_is_current": true,
      "title": "Unsorted Notes",
      "content": "# Unsorted Notes\nThis directory acts as our team inbox. It contains raw thoughts, audio transcriptions, and messy drafts that need to be categorized, summarized, and moved to their proper places within the vault hierarchy.",
      "created_at": "2026-05-24T19:39:16+00:00Z",
      "updated_at": "2026-05-24T19:39:16+00:00Z",
      "versions": [
        {
          "version": 1,
          "title": "Unsorted Notes",
          "content": "# Unsorted Notes\nThis directory acts as our team inbox. It contains raw thoughts, audio transcriptions, and messy drafts that need to be categorized, summarized, and moved to their proper places within the vault hierarchy.",
